# Copy to .env and fill in. .env is gitignored and must stay that way.

AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bucket for case artifacts. Vectors and pointers live in CockroachDB; the
# case bodies themselves go here.
S3_BUCKET=

# Bare model IDs — NOT the eu.* cross-region inference profile. The profile
# form returns "ValidationException: The provided model identifier is invalid"
# on some accounts, and most Bedrock documentation assumes it. Check with
# `python bedrock_check.py` before changing these.
BEDROCK_CHAT_MODEL=amazon.nova-pro-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# CockroachDB. sslmode=verify-full is what you want against Cloud.
# The CA ships in the repo at certs/root.crt and is found automatically, so
# you do not need an sslrootcert parameter here. Override with COCKROACH_CA
# if your cert lives elsewhere.
COCKROACH_URL=postgresql://<user>:<password>@<host>:26257/defaultdb?sslmode=verify-full

# Optional: explicit path to the cluster CA certificate.
# COCKROACH_CA=/path/to/root.crt
